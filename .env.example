APP_NAME=FitCareer
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fitcareer
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=queue_jobs

FILESYSTEM_DISK=local

AI_PROVIDER=gemini
AI_CV_EXTRACTION_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=30

SCRAPER_HTTP_TIMEOUT=30
SCRAPER_HTTP_CONNECT_TIMEOUT=10
SCRAPER_USER_AGENT="FitCareer/1.0 (job-ingestion)"
SCRAPER_ACCEPT_LANGUAGE="tr-TR,tr;q=0.9,en-US;q=0.8,en;q=0.7"
SCRAPER_DEFAULT_FETCH_LIMIT=10

# Optional job source API keys (never commit real values)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
